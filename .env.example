APP_NAME=Tathya
APP_ENV=development
PROJECT_NAME="Tathya Fact Verification Engine"
FASTAPI_ENV=development

SECRET_KEY=changethis_secret_key_at_least_32_chars_long
JWT_SECRET=changethis_secret_key_at_least_32_chars_long
JWT_ALGORITHM=HS256

FIRST_SUPERUSER=admin@tathya.ai
FIRST_SUPERUSER_PASSWORD=changethis

# Use: postgresql://postgres:<password>@127.0.0.1:5432/tathya
DATABASE_URL=postgresql://postgres:YOURPASSWORD@127.0.0.1:5432/tathya
POSTGRES_PASSWORD=YOURPASSWORD

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
HHEM_MODEL=vectara/hallucination_evaluation_model
USE_HHEM=false
TORCH_DEVICE=auto

MODEL_CACHE_DIR=./data/models
LLM_CACHE_DIR=./data/cache
STORAGE_DIR=./storage

ECDSA_PRIVATE_KEY_PATH=./secrets/passport_private.pem
ECDSA_PUBLIC_KEY_PATH=./secrets/passport_public.pem

# Frontend & Mobile
VITE_API_BASE_URL=http://localhost:8001
FRONTEND_HOST=http://localhost:5173
