{
  "expo": {
    "name": "mobile",
    "slug": "mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/tathya-mark-v2.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F8F7F3",
        "foregroundImage": "./assets/tathya-mark-v2.png"
      }
    },
    "web": {
      "favicon": "./assets/tathya-mark-v2.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ]
  }
}
